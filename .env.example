# 网页访问端口（默认 5244，一般不用改）
PORT=5244

# 直链签名密钥，安装时自动生成，不要手动改（改了会导致正在播放的链接失效）
STREAM_SECRET=

# ============ 下载 ============
# 默认直连 aria2（AList 一直在用的那一个），文件直接下到 downloads/，
# 不再经「AList 临时目录 → 转存」两段式，所以下载中就能播。
# aria2 连不上时前端会自动回退到 AList 离线下载。
ARIA2_URL=http://alist:6800/jsonrpc
ARIA2_SECRET=
ARIA2_DIR=/root/Download                  # aria2 容器内看到的下载目录，一般不用改
SEED_TIME=0                               # 0 = 下完不做种（否则任务永远结束不了）
BT_PRIORITIZE_PIECE=head=32M,tail=32M     # 先抓文件头尾，边下边播的关键

# ============ 播放与转码 ============
# 遇到浏览器播不了的格式（MKV / H.265 / AC3 / DTS）时，服务端会自动转码成 HLS。
# 转码要吃 CPU，机器越弱就把 MAX_HEIGHT 调越低；顺带还能省很多 VPS 流量。
MAX_HEIGHT=720          # 转码高度上限：480 / 720 / 1080
VIDEO_QUALITY=23        # 画质，18-28，数字越小越清晰也越吃 CPU
X264_PRESET=veryfast    # ultrafast / superfast / veryfast / faster，越靠前越省 CPU
TRANSCODE_JOBS=2        # 同时运行的 ffmpeg 数，建议等于 CPU 核数
SEG_SECONDS=6           # HLS 分片时长
PREWARM_SEGMENTS=3      # 预先烤好后面几片，减少卡顿
VIDEO_ENCODER=libx264   # 有硬件编码时可换 h264_nvenc / h264_qsv / h264_vaapi
HWACCEL=none            # 硬件解码：none / auto / vaapi / qsv / cuda

# ============ 自动清理 ============
RETENTION_HOURS=1       # 下载文件保留小时数，0 = 永不自动删
KEEP_PLAYING_PROTECT=1  # 1 = 正在看的文件到期也先留着；0 = 到点就删，一秒不留
MAX_DISK_PERCENT=90     # 磁盘占用超过该百分比就先删最旧的
CACHE_MAX_MB=4096       # 转码分片缓存上限
CLEAN_INTERVAL=300      # 清理检查间隔（秒）

# ============ 安全 ============
AUTH_ENFORCE=1          # 1 = 视频直链和目录列表都要登录票据（强烈建议保持 1）
